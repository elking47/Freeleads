# Copy to .env and fill in. Never commit .env: it holds secrets.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Required in production (>= 32 random characters). Signs session tokens and CSRF tokens.
SESSION_SECRET=

# SQLite file (relative to the project root).
DATABASE_PATH=data/freeleads.db

# Number of reverse proxies in front of the app (0 when exposed directly). Needed for correct
# client IPs in rate limiting.
TRUST_PROXY=0

SESSION_TTL_DAYS=7

# Daily delivery time.
DELIVERY_HOUR=8
DELIVERY_TIMEZONE=Europe/Paris
